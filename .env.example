# Copie para .env (Copy-Item .env.example .env) e troque os valores
# Usuário, senha e banco precisam bater com o docker-compose.yml
# Caracteres especiais na senha vão codificados na URL (ex.: @ vira %40)
DATABASE_URL = "postgresql://USUARIO:SENHA@localhost:5432/raizes_nordeste?schema=public"
PORT = 3000
NODE_ENV = development
# Texto aleatório com no mínimo 32 caracteres
JWT_SECRET = "TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES"
# true só em desenvolvimento: libera o pagamento simulado
MOCK_PAYMENTS_ENABLED = true
